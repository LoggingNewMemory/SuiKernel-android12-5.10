menu "Kana Custom Android Drivers"

config OCHINAI_INAHO
	tristate "Ochinai Inaho — SCHED_FIFO + PM QoS tuning"
	depends on CPU_FREQ && SCHED_DEBUG
	help
	  Boosts audio threads to SCHED_FIFO priority, locks CPU latency
	  via PM QoS.

config SPARXIE_SWAP_TUNER
	tristate "Tune the swappiness value"
	help
	  Change the value of the swappiness, by this I make it 30 check
	  using cat /proc/sys/vm/swappiness

config RACO_RC_OVERRIDE
	bool "Raco Override Universal .rc Override API"
	default y
	help 
	  To counter the sysfs write by rogue vendor init.rc scripts during boot.
	  Please see include/linux/raco_override.h

config PAVOLIA_REINE_RESETPROP
	tristate "Pavolia Reine API resetprop tool"
	depends on KSU || YAMADA_KSU_CORE
	default y
	help
	  Please see the required Patches for this (See Bulder/PavoliaReinePatch.sh)
	  And please see include/linux/pavolia_reine_setprop.h

config SANDEVISTAN_BOOT
	tristate "Sandevistan Boot — temporary performance governor boost"
	depends on CPU_FREQ && CPU_FREQ_GOV_PERFORMANCE && CPU_FREQ_GOV_SCHEDUTIL
	help
	  Sets the CPUfreq governor to 'performance' during boot for
	  BOOST_DELAY_SEC seconds, then reverts to 'schedutil'.

config KANA_TOUCH_BOOST
	tristate "Kana Touch Boost — Universal CPU input boost (PM QoS)"
	depends on CPU_FREQ && INPUT
	default y
	help
	  Boosts CPU frequencies to maximum via PM QoS frequency constraints
	  on touch input events across any governor. Reverts after boost window.

config YAMADA_TENEBRION
	tristate "Tenebrion — CPU freq drop on screen off"
	depends on CPU_FREQ && SUSPEND
	help
	  Drops all CPU frequencies to minimum on system suspend,
	  restores full range on resume.

config GOV_ENFORCER
	tristate "Governor Enforcer — enforce user predefined CPU governor"
	depends on CPU_FREQ && RACO_RC_OVERRIDE
	default y
	help
	  Enforces user-selected CPU governor and prevents vendor init.rc
	  from overriding it.

config YAMADA_DEV_IDENTIFICATION
	tristate "Identification of this kernel developer IS"
	depends on PAVOLIA_REINE_RESETPROP
	help
	  This is actually to test PAVOLIA_REINE_SETPROP but eh, it would be a
	  good Identification that this kernel is make by me anyway. This will
	  be also an example usage of PAVOLIA_REINE_SETPROP API

config AYUNDA_RISU_SAFEPROP
	tristate "Spoof some props for reduced root detection"
	depends on PAVOLIA_REINE_RESETPROP
	help
	  Set some props using resetprop in order to fix some detection. This
	  However not magically gives your device locked state, spoof basic
	  Google integrity, this only help reduce detection of banking apps 
	  on your devices

config AIRANI_IOFIFTEEN_CPUSET
	tristate "Maximum CPUSet tweaks"
	depends on RACO_RC_OVERRIDE
	help
	  Some devices not set max CPU cores to the max, to fix this. Let's
	  just make this. This also helpful if PowerHAL try to change it -_-

config ANYA_MELFISSA_THERMAL
	tristate "Anya Disable Thermal — kernel-side thermal zone disabler"
	depends on CPU_FREQ
	help
	  Disables all thermal zones at boot by writing 'disabled'
	  to each thermal zone's mode sysfs node.

config MOONA_HOSHINOVA_ZRAM
	tristate "ZRAM Tweaks and Override vendor init rc"
	depends on RACO_RC_OVERRIDE
	help
	  Some OEMs are just don't give a fk about ZRAM things and some puts
	  Unoptimized Value and Configurations on the devices without knowing
	  The actual better performance and memory. This however try to be as
	  Universal as possible and may give a better memory and performance

config KANAGAWA_PERMISSIVE
	bool "Kanagawa Permissive"
	default n
	help
	  Make ROM permissive via Kernel side. This will also append -PERMISSIVE
	  to the kernel uname.

config KUREIJI_OLLIE_AFFINITY
	tristate "Modifies kswapd to highest CPU cores"
	depends on RACO_RC_OVERRIDE
	help
	  Modifies kswapd Affinity to just highest CPU Cores, AKA: Big or Prime
	  Depends on what policyx are. When OEMs just do nonsense thing that may
	  not suitable. This kernel will save your performance for gaming


config YAMADA_KSU_CORE
	bool "Kana Minimal KernelSU Core (Vanilla)"
	default y
	depends on !KSU
	help
	  This provides minimal native KernelSU-like features (like SELinux rule
	  injection and init.rc property appending) for the Vanilla variant where
	  the official KernelSU Next is not installed.

	  Credits: Referenced and adapted from KernelSU (weishu) and KernelSU
	  Next (KernelSU Next Team / rifsxd) under GPL-3.0.

config SUIKERNEL_MANAGER_VERSION_VERIFIER
	tristate "SuiKernel Manager Version Verifier"
	default y
	help
	  Exposes the supported SuiKernel Manager version to user space via /proc
	  and system properties for manager version verification.

endmenu
